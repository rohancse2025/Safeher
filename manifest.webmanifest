{
  "name": "SafeHer",
  "short_name": "SafeHer",
  "description": "Women Safety and Emergency Alert web app",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#A80F3C",
  "theme_color": "#A80F3C",
  "icons": [
    {
      "src": "./assets/logo.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./assets/logo.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "SOS Alert",
      "short_name": "SOS",
      "description": "Trigger immediate emergency alert",
      "url": "./?sos=1",
      "icons": [
        {
          "src": "./assets/logo.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
